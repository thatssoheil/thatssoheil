{
	"name": "thatssoheil",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"check:tokens": "node scripts/check-tokens.mjs",
		"check:stale-utilities": "node scripts/check-stale-utilities.mjs",
		"check:mobile-scroll": "node scripts/check-mobile-scroll-stability.mjs",
		"check:resume": "node scripts/check-resume.mjs",
		"test": "pnpm lint && pnpm typecheck && pnpm check:tokens && pnpm check:stale-utilities && pnpm check:mobile-scroll && pnpm check:resume",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@gsap/react": "^2.1.2",
		"@opennextjs/cloudflare": "^1.20.1",
		"@phosphor-icons/react": "^2.1.10",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"gsap": "^3.15.0",
		"next": "~16.2.11",
		"radix-ui": "^1.6.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.1",
		"@types/node": "^25.9.4",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.39.4",
		"eslint-config-next": "~16.2.11",
		"shadcn": "^4.12.0",
		"tailwindcss": "^4.3.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"wrangler": "^4.147.0"
	},
	"pnpm": {
		"overrides": {
			"baseline-browser-mapping": "2.11.0",
			"brace-expansion@^2.0.0": "2.1.7",
			"brace-expansion@^5.0.0": "5.0.12",
			"browserslist": "4.28.7",
			"nanoid@^3.0.0": "3.3.18",
			"postcss": "8.5.23",
			"proxy-addr": "2.0.8",
			"qs": "6.16.0",
			"sharp": "0.35.5",
			"source-map-js": "1.2.2"
		}
	}
}
