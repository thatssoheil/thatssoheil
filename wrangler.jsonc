/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "thatssoheil",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-02-27",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "thatssoheil"
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	// workers.dev production URL is off (the site is served on the apex custom
	// domain); workers.dev preview URLs stay on (e.g.
	// dev-thatssoheil.nodeontop.workers.dev). Both declared so deploys keep
	// this state instead of reverting to defaults.
	"workers_dev": false,
	"preview_urls": true,
	// Apex custom domain: production only. previews_enabled is intentionally
	// false on the apex: custom-domain previews there add a *.thatssoheil.website
	// wildcard whose dispatch claims every subdomain of the zone (it hijacked
	// agent.thatssoheil.website, which must reach the NYC tunnel, and would
	// break any future subdomain too). Branch previews are served on the
	// dedicated preview hostname below.
	"routes": [
		{
			"pattern": "thatssoheil.website",
			"custom_domain": true,
			"previews_enabled": false
		},
		// Dedicated preview hostname: previews are served at
		// <preview-name>.dev.thatssoheil.website. Declared so deploys keep it.
		{
			"pattern": "dev.thatssoheil.website",
			"custom_domain": true,
			"enabled": false,
			"previews_enabled": true
		}
	],
	"vars": {
		"AI_SOHEIL_API_URL": "https://agent.thatssoheil.website/v1",
		"ENABLE_CHAT": "false"
	},
	// Per-IP rate limit for the AI Soheil chat proxy. period must be 10 or 60s.
	// AI_SOHEIL_API_KEY is a secret — set via `wrangler secret put AI_SOHEIL_API_KEY`
	// (prod) and .dev.vars (local). Never put the key in this file.
	"ratelimits": [
		{
			"name": "CHAT_RATELIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	/**
	 * Worker Previews — the `dev` branch's isolated environment under this same
	 * Worker, created by `wrangler preview` in Workers Builds. Previews do not
	 * inherit production settings, so non-inheritable keys are restated here:
	 * vars, images, services, ratelimits.
	 */
	"previews": {
		"vars": {
			"AI_SOHEIL_API_URL": "https://agent.thatssoheil.website/v1",
			"ENABLE_CHAT": "false"
		},
		"images": {
			"binding": "IMAGES"
		},
		"services": [
			{
				"binding": "WORKER_SELF_REFERENCE",
				"service": "thatssoheil"
			}
		],
		"ratelimits": [
			{
				"name": "CHAT_RATELIMIT",
				"namespace_id": "1001",
				"simple": { "limit": 10, "period": 60 }
			}
		]
	},
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
}